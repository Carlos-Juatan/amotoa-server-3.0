# Database settings
# No Docker Compose, o backend conecta ao MongoDB via nome do serviço 'mongodb':
MONGODB_URI=mongodb://mongodb:27017/amotoa
# Para execução local direta no host (sem Docker no backend):
# MONGODB_URI=mongodb://localhost:27017/amotoa

PROJECT_NAME="Amontoa Server Hub"
API_V1_STR=/api

# Docker Compose settings (opcional)
# MONGODB_PORT=27017
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
